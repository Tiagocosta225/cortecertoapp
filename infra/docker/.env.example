DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dbcortes
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dbcortes?schema=public
ADMIN_API_KEY=troque-por-uma-chave-forte
ALLOWED_ORIGINS=http://frontend.local,http://admin.local
TRUST_PROXY=true
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_HOST=frontend.local
ADMIN_HOST=admin.local
LANDING_HOST=landing.local
SSL_CERT_PATH=/etc/nginx/certs/origin.crt
SSL_KEY_PATH=/etc/nginx/certs/origin.key
