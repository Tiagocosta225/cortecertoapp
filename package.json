{
  "name": "cortecertoapp",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:public-web": "npm run dev -w @cortecerto/public-web",
    "dev:admin-panel": "npm run dev -w @cortecerto/admin-panel",
    "dev:landing": "npm run dev -w @cortecerto/landing",
    "dev:backend": "npm run dev -w @cortecerto/backend",
    "dev:mobile": "npm run dev -w @cortecerto/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "compose:up": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env up --build",
    "compose:up:cloudflare": "docker compose --profile cloudflare -f infra/docker/docker-compose.yml --env-file infra/docker/.env up --build -d",
    "compose:down": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env down",
    "compose:logs": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env logs -f"
  }
}
